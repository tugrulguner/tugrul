{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tugrul-site",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-09-28",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/x-articles", "/api/x-articles/*"],
    "not_found_handling": "404-page"
  },
  "kv_namespaces": [
    { "binding": "ARTICLES_KV" }
  ],
  "triggers": {
    "crons": ["0 9 * * *"]
  },
  "routes": [
    {
      "pattern": "tugrul.modepot.io",
      "custom_domain": true
    }
  ]
}
